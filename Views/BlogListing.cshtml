@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;

    string V(string alias) => Model.Value<string>(alias) ?? string.Empty;

    var title = V("listingTitle");
    var lead = V("listingLead");
    var pageTitle = string.IsNullOrWhiteSpace(title) ? "Community &amp; News" : title;

    var posts = Model.ChildrenOfType("blogPost")
        .Where(x => x.IsVisible())
        .OrderBy(x => x.Name)
        .ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Html.Raw(pageTitle) — Champions 4 Heroes</title>
    <meta name="description" content="@lead" />
    <meta name="theme-color" content="#0b0f14" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/css/styles.css")" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='18' fill='%230b0f14'/><text x='50' y='68' font-size='48' text-anchor='middle' font-family='Arial Black,Arial' fill='%23f2c14e'>4</text></svg>" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" id="siteHeader">
        <div class="container nav-wrap">
            <a class="brand" href="@Url.Content("~/")" aria-label="Champions 4 Heroes home">
                <span class="brand-mark" aria-hidden="true">4</span>
                <span class="brand-text">Champions <span class="brand-num">4</span> Heroes</span>
            </a>

            <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="siteNav" aria-label="Open menu">
                <span></span><span></span><span></span>
            </button>

            <nav class="site-nav" id="siteNav" aria-label="Primary">
                <ul>
                    <li><a href="@Url.Content("~/")#mission">Mission</a></li>
                    <li><a href="@Url.Content("~/")#story">Nate's Story</a></li>
                    <li><a href="@Url.Content("~/")#programs">What We Do</a></li>
                    <li><a href="@Url.Content("~/")#watch">Watch</a></li>
                    <li><a href="@Url.Content("~/blog/")">Blog</a></li>
                    <li><a href="@Url.Content("~/")#involved">Get Involved</a></li>
                </ul>
                <a class="btn btn-primary btn-sm nav-cta" href="@Url.Content("~/")#involved">Support the Mission</a>
            </nav>
        </div>
    </header>

    <main id="main">
        <section class="page-hero">
            <div class="container">
                <p class="eyebrow">Champions 4 Heroes</p>
                <h1>@Html.Raw(pageTitle)</h1>
                @if (!string.IsNullOrWhiteSpace(lead))
                {
                    <p class="hero-lead">@lead</p>
                }
            </div>
        </section>

        <section class="section">
            <div class="container">
                @if (posts.Count == 0)
                {
                    <p class="watch-note reveal">No posts have been published yet.</p>
                }
                else
                {
                    <div class="blog-grid">
                        @foreach (var post in posts)
                        {
                            var image = post.Value<string>("imageFile");
                            var alt = post.Value<string>("imageAlt");
                            var author = post.Value<string>("postAuthor");
                            var eventTag = post.Value<string>("eventTag");
                            var body = post.Value<string>("postBody");
                            var postTitle = post.Value<string>("postTitle");
                            var sourceUrl = post.Value<string>("sourceUrl");
                            var href = post.Url();

                            <article class="blog-card reveal">
                                <a class="blog-card-media" href="@href" tabindex="-1" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(image))
                                    {
                                        <img src="@Url.Content($"~/img/blog/{image}")" alt="@alt" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="blog-card-placeholder">4</span>
                                    }
                                </a>
                                <div class="blog-card-body">
                                    @if (!string.IsNullOrWhiteSpace(eventTag))
                                    {
                                        <span class="blog-tag">@eventTag</span>
                                    }
                                    <h2><a href="@href">@postTitle</a></h2>
                                    <p>@body</p>
                                    <div class="blog-card-meta">
                                        @if (!string.IsNullOrWhiteSpace(author))
                                        {
                                            <span>@author</span>
                                        }
                                        <a class="text-link" href="@sourceUrl" target="_blank" rel="noopener noreferrer">View on Facebook</a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="cta-banner">
            <div class="container cta-inner reveal">
                <h2>For Nate. For every veteran. For every hero.</h2>
                <a class="btn btn-primary" href="@Url.Content("~/")#involved">Join the fight</a>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div class="container footer-bottom">
            <p>&copy; <span id="year">2026</span> Michael Nathan Twining Foundation · Champions 4 Heroes. All rights reserved.</p>
            <p class="footer-note">Honoring our heroes by serving those who served.</p>
        </div>
    </footer>

    <button class="back-to-top" id="backToTop" aria-label="Back to top" hidden>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 5l7 7-1.4 1.4L13 8.8V20h-2V8.8l-4.6 4.6L5 12l7-7Z"/></svg>
    </button>

    <script src="@Url.Content("~/js/main.js")" defer></script>
</body>
</html>